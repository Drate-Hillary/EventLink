# Copy to .env and set real values: cp .env.example .env
WEB_PORT=8080
# Postgres connection used by src/prisma/db.ts. For Supabase, use the pooled
# connection string for DATABASE_URL and the direct one for migrations.
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres
REDIS_PASSWORD=change-me-to-a-long-random-string
